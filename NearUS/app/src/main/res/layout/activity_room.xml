<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/activityZoneWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#04080F" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:background="#D9080E1C"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/roomIdText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Active Room: NUS9158"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Connected"
            android:textColor="@color/live_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/quick_access_card_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:elevation="8dp">

        <FrameLayout
            android:id="@+id/localVideoFrame"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/quick_access_card_bg" />

        <FrameLayout
            android:id="@+id/remoteVideoFrame"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/quick_access_card_bg" />
    </LinearLayout>

</RelativeLayout>